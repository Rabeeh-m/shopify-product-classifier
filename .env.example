# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_ENV=dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (used by base settings; dev.py overrides to SQLite)
DB_NAME=shopify_product_classifier
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Uploads
MAX_UPLOAD_SIZE_MB=10

# AI Classification
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_MODEL_NAME=claude-sonnet-4-20250514
AI_REQUEST_TIMEOUT=30
CLASSIFICATION_CANDIDATE_LIMIT=15
CLASSIFICATION_CONFIDENCE_THRESHOLD=70
CLASSIFICATION_MAX_RETRIES=3
CLASSIFICATION_CONCURRENCY_LIMIT=5

# Taxonomy
TAXONOMY_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production-only (DJANGO_ENV=prod)
# SECURE_HSTS_SECONDS=31536000
# SECURE_SSL_REDIRECT=True
# REDIS_URL=redis://localhost:6379/1
# GUNICORN_WORKERS=4
# GUNICORN_TIMEOUT=120
# GUNICORN_BIND=0.0.0.0:8000

# Docker (set in docker-compose.prod.yml, override here if needed)
# RUN_MIGRATIONS=true

# Monitoring (optional)
SENTRY_DSN=
