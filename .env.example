# Django
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# AI Classification
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL_NAME=gemini-3.5-flash-lite
AI_REQUEST_TIMEOUT=30
# Client-side RPM cap shared across workers (Gemini free tier: 15; 0 disables)
AI_RATE_LIMIT_RPM=15
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY=2.0
CLASSIFICATION_CANDIDATE_LIMIT=15
CLASSIFICATION_CONFIDENCE_THRESHOLD=70
CLASSIFICATION_CONCURRENCY_LIMIT=5
# Rule-based classification before AI (recommended for large imports on free tier)
RULE_CLASSIFICATION_ENABLED=true
RULE_AUTO_CLASSIFY_MIN_SCORE=6.0
RULE_MIN_SCORE_GAP=2.0
RULE_VENDOR_CONFIDENCE=90
RULE_KEYWORD_CONFIDENCE_BASE=70

# Taxonomy
TAXONOMY_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
